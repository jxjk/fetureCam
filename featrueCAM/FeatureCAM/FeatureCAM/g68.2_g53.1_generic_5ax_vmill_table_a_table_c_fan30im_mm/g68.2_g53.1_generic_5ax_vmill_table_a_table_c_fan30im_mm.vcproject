    <Line>$$ Pro/Manufacturing</Line>
    <Line></Line>
    <Line>CYCLE/DRILL,#fedto,#fedupm,IPM,#rapto</Line>
    <Line>USEWITH:PTC</Line>
    <Line>CYCLE/DRILL,DEPTH,#fedto,IPM,#fedupm</Line>
    <Line>USEWITH:PTC</Line>
    <Line>CYCLE/DRILL,DEPTH,#fedto,IPM,#fedupm,CLEAR,#rapto</Line>
    <Line>USEWITH:PTC</Line>
    <Line>CYCLE/DRILL,DEPTH,#fedto,IPM,#fedupm,CLEAR,#rapto,RETURN,#rtrcto</Line>
