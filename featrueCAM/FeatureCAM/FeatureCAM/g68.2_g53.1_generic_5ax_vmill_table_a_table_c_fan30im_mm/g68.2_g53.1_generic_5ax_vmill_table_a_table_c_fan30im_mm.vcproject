  <Cycles>
    <Line></Line>
    <Line>$$ ACL.</Line>
    <Line></Line>
    <Line>CYCLE/DRILL,#fedto,IPM,#fedupm,#rapto</Line>
    <Line>USEWITH:ACL</Line>
    <Line>CYCLE/REAM,#fedto,IPM,#fedupm,#rapto</Line>
    <Line>USEWITH:ACL</Line>
    <Line>CYCLE/FACE,#fedto,IPM,#fedupm,#rapto</Line>
    <Line>USEWITH:ACL</Line>
    <Line>CYCLE/TAP,#fedto,IPM,#fedupm,#rapto</Line>
    <Line>MODALS:retract_mode=fedrat</Line>
    <Line>USEWITH:ACL</Line>
    <Line>CYCLE/BORE,#fedto,IPM,#fedupm,#rapto</Line>
    <Line>MODALS:retract_mode=fedrat</Line>
    <Line>USEWITH:ACL</Line>
    <Line>CYCLE/MILL,#fedto,IPM,#fedupm,#rapto</Line>
    <Line>MODALS:retract_mode=none</Line>
    <Line>USEWITH:ACL</Line>
    <Line>CYCLE/CSINK,#fedto,#,IPM,#fedupm,#rapto</Line>
    <Line>USEWITH:ACL</Line>
    <Line>CYCLE/CSINK,#cskdia,IPM,#fedupm,#rapto</Line>
    <Line>MODALS:retract_mode=fedrat</Line>
    <Line>USEWITH:ACL</Line>
    <Line>CYCLE/CSINK,#cskdia,RAPTO,#rapto,RTRCTO,#rtrcto,TLANGL,#tlangl, $</Line>
    <Line>IPM,#fedupm</Line>
    <Line>MODALS:retract_mode=fedrat</Line>
    <Line>USEWITH:ACL</Line>
    <Line>CYCLE/DEEP,#fedlist,IPM,#fedupm,#rapto,#steprap</Line>
    <Line>USEWITH:ACL</Line>
    <Line>CYCLE/DEEP,#fedto,INCR,#step,IPM,#fedupm,#rapto,#steprap</Line>
    <Line>USEWITH:ACL</Line>
    <Line>CYCLE/THRU,#fedlist,IPM,#fedupm,#rapto</Line>
    <Line>MODALS:deep_retract=off,thru_mode=on</Line>
    <Line>USEWITH:ACL</Line>
    <Line></Line>
    <Line>$$ VERICUT, CADRA and CV (Generic).</Line>
    <Line></Line>
    <Line>CYCLE/DRILL,#fedto,#fedupm,IPM,#rapto</Line>
    <Line>USEWITH:VERICUT,CADRA,CV</Line>
