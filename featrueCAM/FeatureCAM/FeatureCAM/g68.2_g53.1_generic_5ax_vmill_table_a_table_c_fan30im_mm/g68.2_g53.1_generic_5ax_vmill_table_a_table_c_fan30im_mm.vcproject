    <Line>USEWITH:VERICUT,CADRA,CV</Line>
    <Line>CYCLE/FACE,RAPTO,#rapto,FEDTO,#fedto,RTRCTO,#rtrcto</Line>
    <Line>USEWITH:VERICUT,CADRA,CV</Line>
    <Line>CYCLE/TAP,#fedto,#fedupm,IPM,#rapto</Line>
    <Line>MODALS:retract_mode=fedrat</Line>
    <Line>USEWITH:VERICUT,CADRA,CV</Line>
    <Line>CYCLE/TAP,RAPTO,#rapto,FEDTO,#fedto</Line>
    <Line>MODALS:retract_mode=fedrat</Line>
    <Line>USEWITH:VERICUT,CADRA,CV</Line>
    <Line>CYCLE/TAP,RAPTO,#rapto,FEDTO,#fedto,RTRCTO,#rtrcto</Line>
    <Line>MODALS:retract_mode=fedrat</Line>
    <Line>USEWITH:VERICUT,CADRA,CV</Line>
    <Line>CYCLE/BORE,#fedto,#fedupm,IPM,#rapto</Line>
    <Line>MODALS:retract_mode=fedrat</Line>
    <Line>USEWITH:VERICUT,CADRA,CV</Line>
    <Line>CYCLE/BORE,RAPTO,#rapto,FEDTO,#fedto</Line>
    <Line>MODALS:retract_mode=fedrat</Line>
